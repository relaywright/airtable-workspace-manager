{
  "name": "airtable-workspace-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop app for visualizing and managing Airtable workspace architecture",
  "license": "MIT",
  "author": "relaywright",
  "keywords": [
    "airtable",
    "electron",
    "schema",
    "workspace",
    "visualization",
    "local-first",
    "desktop"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5174 && electron .",
    "capture:demo": "node scripts/capture-demo.mjs",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "test": "vitest run && npm run test:electron",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && vitest run --config vitest.config.electron.js --coverage",
    "test:ui": "vitest --ui",
    "test:electron": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.electron.js",
    "check:clean": "node scripts/check-clean.mjs",
    "release:snapshot": "node scripts/release-snapshot.mjs",
    "denylist:add": "node scripts/build-denylist.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cytoscape": "^3.28.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "electron-store": "^8.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.3.1",
    "@vitest/ui": "^1.3.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^24.0.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.0",
    "vitest": "^1.3.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.workspace-manager.app",
    "productName": "Airtable Workspace Manager",
    "artifactName": "Airtable-Workspace-Manager-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "fixtures/**/*",
      "build/icon.png",
      "!electron/**/*.test.mjs"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    }
  }
}
