{
  "tables": [
    {
      "id": "tblDemoISku000001",
      "name": "SKU List",
      "primaryFieldId": "fldDemoISku000001",
      "syncSource": { "sourceApplicationId": "appDemoProduct001", "sourceTableId": "tblDemoProd000001" },
      "fields": [
        { "id": "fldDemoISku000001", "name": "Product Name", "type": "singleLineText" },
        { "id": "fldDemoISku000002", "name": "SKU", "type": "singleLineText" },
        { "id": "fldDemoISku000003", "name": "Barcode", "type": "barcode" },
        { "id": "fldDemoISku000004", "name": "Weight (lb)", "type": "number", "options": { "precision": 1 } },
        {
          "id": "fldDemoISku000005",
          "name": "Status",
          "type": "singleSelect",
          "options": {
            "choices": [
              { "id": "selDemoISku0501", "name": "Active", "color": "blueLight2" },
              { "id": "selDemoISku0502", "name": "Draft", "color": "cyanLight2" },
              { "id": "selDemoISku0503", "name": "Seasonal", "color": "tealLight2" },
              { "id": "selDemoISku0504", "name": "Discontinued", "color": "greenLight2" }
            ]
          }
        },
        {
          "id": "fldDemoISku000006",
          "name": "Stock Levels",
          "type": "multipleRecordLinks",
          "options": {
            "linkedTableId": "tblDemoStck000001",
            "isReversed": false,
            "prefersSingleRecordLink": false
          }
        },
        {
          "id": "fldDemoISku000007",
          "name": "On Hand Total",
          "type": "rollup",
          "options": {
            "recordLinkFieldId": "fldDemoISku000006",
            "fieldIdInLinkedTable": "fldDemoStck000004",
            "formula": "SUM(values)"
          }
        },
        {
          "id": "fldDemoISku000008",
          "name": "Reorder Point",
          "type": "number",
          "options": { "precision": 0 }
        },
        {
          "id": "fldDemoISku000009",
          "name": "Needs Reorder",
          "type": "formula",
          "options": { "formula": "{On Hand Total} <= {Reorder Point}", "result": { "type": "number" } }
        }
      ]
    },
    {
