          "options": { "precision": 2, "symbol": "$" }
        },
        {
          "id": "fldDemoBdgt000006",
          "name": "Variance",
          "type": "formula",
          "options": { "formula": "{Actual} - {Planned}", "result": { "type": "currency" } }
        },
        {
          "id": "fldDemoBdgt000007",
          "name": "Variance %",
          "type": "formula",
          "options": { "formula": "({Actual} - {Planned}) / {Planned}", "result": { "type": "percent" } }
