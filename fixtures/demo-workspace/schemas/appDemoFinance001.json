          }
        },
        {
          "id": "fldDemoBdgt000003",
          "name": "Quarter",
          "type": "singleSelect",
          "options": {
            "choices": [
              { "id": "selDemoBdgt0301", "name": "Q1", "color": "blueLight2" },
              { "id": "selDemoBdgt0302", "name": "Q2", "color": "cyanLight2" },
              { "id": "selDemoBdgt0303", "name": "Q3", "color": "tealLight2" },
              { "id": "selDemoBdgt0304", "name": "Q4", "color": "greenLight2" }
